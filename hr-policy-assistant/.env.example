# Copy to .env and fill in your keys ( this env.example is the current not prod env file which i wil change after getting LLM api keys from gateway group if proceeded for anotherr round of interview 
Note : As for assigment development and testing needs a LLM API and also considerable amound of token i kept this empty and made it mannual to easily change the LLM depending on cost and other requirement like accuracy . 
LLM_PROVIDER=deepseek  # Change this to switch models!
# Choose your model provider: "openai", "deepseek", or "gemini"

# API Keys (only need the one for your chosen provider)
OPENAI_API_KEY=sk-your-openai-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Embeddings (keep using OpenAI for embeddings - it's cheap)
OPENAI_API_KEY_FOR_EMBEDDINGS=sk-your-openai-key-here

# Optional: LangSmith for tracing (free tier available)
LANGCHAIN_API_KEY=lsv2-your-langsmith-key-here
LANGCHAIN_TRACING_V2=false
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
